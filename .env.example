NODE_ENV=development
PORT=3000
# Host port used only by Docker Compose; the container still listens on PORT.
API_PORT=3001
API_PREFIX=api/v1
# El navegador habla con el backend casi siempre a través del BFF de la web
# (host.docker.internal / same-origin), donde el CORS del navegador no aplica.
# La excepción es el socket de chat (/chat): el navegador lo abre directo
# contra este origen porque una ruta BFF de Next no puede proxiar un upgrade
# de WebSocket. Por eso el puerto de la web (3002 en local) tiene que estar
# en esta lista, o el handshake del socket lo rechaza el propio navegador.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3002
TRUST_PROXY=false
# Saltos de proxy confiables: el BFF web reenvía X-Forwarded-For para que el límite por IP use la IP real del cliente.
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
BUSINESS_TIME_ZONE=America/La_Paz

# Alta pública de cuentas de negocio (POST /business/signup, ADR-0020). Apagada por
# defecto hasta que el abogado firme los textos legales de negocios; en producción
# sigue cerrada mientras esos textos sean borradores aunque se ponga en true.
BUSINESS_SIGNUP_ENABLED=false
# Consultas de disponibilidad de @handle por cliente y ventana RATE_LIMIT_TTL_SECONDS.
HANDLE_AVAILABILITY_RATE_LIMIT_MAX=30

# KYC de negocios (ADR-0021). KYC_ENCRYPTION_KEY es OBLIGATORIA en producción (>= 32
# caracteres, la API no arranca sin ella) y nunca se deriva de los secretos JWT: cifra NIT,
# CI, teléfono y documentos, y con otra derivación los comprobantes y QR de cobro de los pedidos
# (ADR-0024); perderla pierde todos esos archivos. Sin ella (o sin IP_HASH_SECRET)
# fuera de producción el KYC responde 503. Genérala con: openssl rand -hex 32
KYC_ENCRYPTION_KEY=
KYC_PIPELINE_BUDGET_MS=2000
KYC_CHECK_STATEMENT_TIMEOUT_MS=500
# SLA de REPP: cola de revisión en horas hábiles (lun-vie) y revisión posterior en horas.
BUSINESS_KYC_REVIEW_SLA_HOURS=24
BUSINESS_KYC_POST_REVIEW_SLA_HOURS=72
# Publicaciones del marketplace (ADR-0022): fuera de la banda de precio (BOB) o a más de
# LISTING_PRICE_OUTLIER_FACTOR veces la mediana de su tipo, la publicación queda retenida para REPP.
LISTING_PRICE_MIN_BOB=1
LISTING_PRICE_MAX_BOB=50000
LISTING_PRICE_OUTLIER_FACTOR=5
LISTING_PRICE_MEDIAN_MIN_SAMPLES=5
# Pedidos del marketplace (ADR-0024). Un pedido por QR sin comprobante vence a las
# ORDER_PAYMENT_TTL_HOURS y uno en efectivo sin confirmar a las ORDER_CASH_TTL_HOURS (liberan su stock).
# Al negocio se le recuerda un comprobante sin decidir a las 24 y 48 horas.
ORDER_PAYMENT_TTL_HOURS=24
ORDER_CASH_TTL_HOURS=72
ORDER_VERIFICATION_FIRST_REMINDER_HOURS=24
ORDER_VERIFICATION_SECOND_REMINDER_HOURS=48
# Unidades por pedido (solo productos), pedidos abiertos por persona y comprobantes por pedido.
ORDER_MAX_QUANTITY=20
ORDER_OPEN_MAX_PER_PERSON=5
ORDER_RECEIPT_MAX_ATTEMPTS=3
# worker:orders-maintenance: pausa entre pasadas ociosas y pedidos por pasada.
ORDERS_MAINTENANCE_INTERVAL_MS=300000
ORDERS_MAINTENANCE_BATCH_SIZE=200
# Código del teléfono: disabled (no se envía; el KYC va a revisión de REPP) o whatsapp-cloud.
BUSINESS_PHONE_OTP_PROVIDER=disabled
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_OTP_TEMPLATE=
# WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=es
# WHATSAPP_CLOUD_API_VERSION=v21.0

# Gimnasio al que se adscriben las cuentas nuevas y las que aun no tienen uno.
# Vacio o ausente = instalacion de una sola marca (identidad de referencia).
DEFAULT_TENANT_ID=topfitness
ACCESS_POLICY_VERSION=2026-07-19
# Prefijo de las rutinas de pruebas automáticas que el catálogo público/oficial y «Para ti» ocultan (TEST: QA-AUTO). Vacío = sin filtro.
CATALOG_HIDDEN_NAME_PREFIX=
ACCESS_MOCK_ENABLED=true
# Número corporativo en formato internacional, solo dígitos (Bolivia: 591 + celular).
WHATSAPP_MEMBERSHIP_PHONE=59177377232
# Optional. When set (min. 32 chars), GET /health/metrics requires
# `Authorization: Bearer <token>`. Leave empty to keep the endpoint open and
# restrict it at network level instead.
METRICS_SCRAPE_TOKEN=
# REQUIRED with NODE_ENV=production (min. 32 chars; the API refuses to start
# without it). Optional elsewhere. Key for the HMAC-SHA256 of every client IP the
# API stores (legal acceptances, signup audit, devices, password resets, admin
# audit, coach downloads) and of the email kept for a sanctioned closed account.
# Raw IPs are never stored; the privacy retention (worker `privacy-retention` or
# `yarn db:privacy:retention`) nulls the hashes after 90 days. Empty outside
# production = no IP evidence and no ban-evasion record is stored.
# Generate one with: openssl rand -hex 32
IP_HASH_SECRET=

# Shared rate-limit counters. Without this, limits are per-process and the
# effective limit multiplies by the number of instances. Required for any
# horizontally scaled deployment.
REDIS_URL=
# Set true in multi-instance deployments to fail startup when REDIS_URL is absent
# instead of silently degrading to per-process rate limiting.
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_sheet
DB_USER=gym_sheet_writer
DB_PASSWORD=replace_with_runtime_secret
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000

JWT_ACCESS_SECRET=replace_with_at_least_64_random_characters_from_a_secret_manager
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_64_character_secret_from_a_secret_manager
# Generar una clave aleatoria propia de al menos 32 caracteres y conservarla para descifrar medios existentes.
# CHAT_MEDIA_ENCRYPTION_KEY=replace_with_a_dedicated_32_character_or_longer_secret
JWT_REFRESH_EXPIRES_IN=180d
JWT_ISSUER=gym-sheet-api
JWT_AUDIENCE=gym-sheet-web

# Vida del PIN de recuperación y fallos tolerados antes de quemarlo.
PASSWORD_RESET_PIN_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

# Inicio de sesión con Google / Apple. Apagados hasta tener credenciales reales
# (rutas en 404). Las listas son los client ids aceptados como `aud`, separados por comas.
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_IDS=
AUTH_APPLE_ENABLED=false
APPLE_CLIENT_IDS=

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# Tráfico anónimo del directorio público de gimnasios (sin sesión).
PUBLIC_RATE_LIMIT_MAX=60

# Anti-bot de alta de cuentas (ADR-0013). Activas por defecto, sin cuenta externa:
# ticket de formulario firmado, honeypot, límites de velocidad y dominios desechables.
# REGISTRATION_TICKET_SECRET: obligatorio en producción (>= 32 caracteres; `openssl rand -hex 32`).
# Fuera de producción, vacío = secreto aleatorio por proceso (aviso en el log).
REGISTRATION_TICKET_SECRET=
# true = sin ticket se rechaza. false sólo para un corte deliberado de clientes viejos.
SIGNUP_TICKET_REQUIRED=true
SIGNUP_MIN_FILL_MS=3000
SIGNUP_LIMIT_PER_IP_HOUR=5
SIGNUP_LIMIT_PER_INSTALLATION_DAY=3
SIGNUP_LIMIT_PER_EMAIL_DOMAIN_HOUR=30
# Proveedores grandes exentos del límite por dominio (minúsculas, separados por comas).
SIGNUP_EMAIL_DOMAIN_ALLOWLIST=gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,yahoo.com,icloud.com,me.com,proton.me,protonmail.com
ANTIBOT_HTTP_TIMEOUT_MS=3000
# Apagadas hasta tener credenciales. Cloudflare Turnstile (sólo canal WEB):
TURNSTILE_SECRET=
# true = si Cloudflare no responde, se rechaza; false = sólo sube el riesgo.
TURNSTILE_FAIL_CLOSED=false
# Play Integrity (Android). iOS App Attest no se verifica todavía: sólo señal de riesgo.
ATTESTATION_ENABLED=false
PLAY_INTEGRITY_PACKAGE_NAME=
# JSON de la cuenta de servicio en UNA línea. NUNCA versionar el valor real.
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# Have I Been Pwned (k-anonimato): sólo marca BREACHED_PASSWORD en el riesgo, no rechaza.
PASSWORD_BREACH_CHECK_ENABLED=false
GATEWAY_ENABLED=true

WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=5
WORKER_LOCK_TIMEOUT_MS=300000
WORKER_MAX_ATTEMPTS=5
# Retention for `yarn db:outbox:prune` (opt-in, dry-run unless run with --apply).
# Only COMPLETED outbox jobs older than this many days are eligible for deletion.
OUTBOX_RETENTION_DAYS=30
OUTBOX_PRUNE_BATCH_SIZE=1000
REMINDER_SCAN_INTERVAL_MS=3600000
# Expired-story purge worker (`yarn worker:stories-purge`). Deletes rows past
# `expires_at` and their files, keeping any file another row still references.
STORIES_PURGE_INTERVAL_MS=3600000
STORIES_PURGE_BATCH_SIZE=200
NOTIFICATION_DELIVERY_PROVIDER=IN_APP
NOTIFICATION_GATEWAY_URL=
RECOMMENDATIONS_URL=
RECOMMENDATIONS_SERVICE_TOKEN=
NOTIFICATION_GATEWAY_SECRET=
NOTIFICATION_GATEWAY_ALLOWED_HOSTS=
NOTIFICATION_GATEWAY_TIMEOUT_MS=10000

# --- Web Push to the browser (VAPID, ADR-0011) ---
# Independent from Expo: mobile push needs no local configuration (its FCM/APNs
# credentials live in the EAS project), the browser needs a VAPID key pair of
# this deployment's own. `DISABLED` is the explicit way of saying "no web push
# here"; asking for VAPID without keys stops the boot (no silent fallback).
# Generate the pair ONCE per deployment with `npx web-push generate-vapid-keys`.
# Rotating it invalidates every existing browser subscription.
# NEVER commit real keys: the private one signs on behalf of this server.
WEB_PUSH_TRANSPORT=DISABLED
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# SSRF allowlist of push services. The subscription endpoint is chosen by the
# client, so without this list the backend would call whatever URL it is handed.
# A browser whose push service is not listed simply cannot subscribe.
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
WEB_PUSH_TIMEOUT_MS=10000
# How long the push service keeps a notification for a closed browser.
WEB_PUSH_TTL_SECONDS=86400

EXERCISES_DATASET_ENABLED=false
EXERCISES_DATASET_JSON_URL=https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main/data/exercises.json
EXERCISES_DATASET_ALLOWED_HOSTS=raw.githubusercontent.com
EXERCISES_DATASET_TIMEOUT_MS=15000
EXERCISES_DATASET_MAX_RESPONSE_BYTES=25000000
EXERCISES_DATASET_BATCH_SIZE=100
EXERCISES_DATASET_MIN_RECORDS=1000
EXERCISES_DATASET_REFRESH_INTERVAL_MS=86400000
EXERCISES_DATASET_REFRESH_RETRY_MS=3600000
EXERCISES_DATASET_IMPORT_MEDIA=false
EXERCISES_DATASET_MEDIA_LICENSE_CONFIRMED=false
# Optional public-domain image enrichment. Only exact normalized names are linked.
EXERCISES_OPEN_MEDIA_ENABLED=true
EXERCISES_OPEN_MEDIA_JSON_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/dist/exercises.json
EXERCISES_OPEN_MEDIA_BASE_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/
# Canonical exercises source at startup (ADR-0006, option b). `seeders` applies a
# local snapshot if present; `github` defers population to the dataset worker and
# requires EXERCISES_DATASET_ENABLED=true (no silent fallback between sources).
CANONICAL_EXERCISES_SOURCE=seeders

# Base seed: both email and password are required by `yarn db:seed:base`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=GymSheet Administrator
# Development-only accounts created by `yarn db:seed:mock`.
SEED_MOCK_PASSWORD=

# --- Media storage (ports & adapters) ---
# Provider selection. `local` stores files on disk via the Multer adapter.
# `minio` stores them in a self-hosted S3-compatible bucket: people's content
# (`users/…`) is really deleted, every version (ADR-0017); the catalog stays
# immutable (ADR-0010).
# `cloudinary`/`s3` require their adapter implemented (no silent fallback).
MEDIA_STORAGE_PROVIDER=local
# Local adapter: on-disk root and the public base URL it is served under.
MEDIA_STORAGE_LOCAL_ROOT=storage/media
MEDIA_STORAGE_PUBLIC_BASE_URL=http://localhost:3000/media
# Upload guards (bytes) and allowed MIME allowlist.
MEDIA_UPLOAD_MAX_BYTES=5242880
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif
# Demostraciones de ejercicio: límite y tipos propios (un vídeo de técnica pesa
# mucho más que una foto de perfil). Se suben a `ejercicios/<id>/` del proveedor
# configurado en MEDIA_STORAGE_PROVIDER.
EXERCISE_MEDIA_MAX_BYTES=52428800
EXERCISE_MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm

# Chat attachments (and stories) carry their own limits: a video weighs far more
# than a profile photo, and video is allowed here but not in MEDIA_ALLOWED_MIME.
CHAT_MEDIA_MAX_BYTES=26214400
CHAT_MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime,audio/mp4
# MinIO adapter. Required only when MEDIA_STORAGE_PROVIDER=minio; the factory
# refuses to boot without them rather than failing upload by upload.
# MINIO_ENDPOINT is the INTERNAL host the API writes to (a Compose service alias
# such as `minio`), never the public URL — that one is
# MEDIA_STORAGE_PUBLIC_BASE_URL. NEVER commit real credentials.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=gymsheet-media
MINIO_REGION=us-east-1
# `true` declares that the MinIO API user may delete every version under
# `users/*` (policy and runbook in ADR-0017); `false` keeps people's content and
# then no text may promise deletion. Only `true`/`false`. Empty means `true`,
# except in production with MEDIA_STORAGE_PROVIDER=minio, where it is required:
# set it to true only after applying the policy. Ignored by `local`.
MEDIA_USER_CONTENT_DELETABLE=
# `yarn db:media:mirror --apply` copies external media.files images into the
# configured storage (forcing JPEG/PNG, fixing AVIF/WebP format breakage) and
# stops serving them straight from the external host. SSRF allowlist below.
MEDIA_MIRROR_ALLOWED_HOSTS=images.unsplash.com,raw.githubusercontent.com
MEDIA_MIRROR_TIMEOUT_MS=15000
# Optional credentials for a future CloudinaryAdapter. NEVER commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gymsheet
