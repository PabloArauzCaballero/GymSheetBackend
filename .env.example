NODE_ENV=development
PORT=3000
# Host port used only by Docker Compose; the container still listens on PORT.
API_PORT=3001
API_PREFIX=api/v1
# El navegador habla con el backend casi siempre a través del BFF de la web
# (host.docker.internal / same-origin), donde el CORS del navegador no aplica.
# La excepción es el socket de chat (/chat): el navegador lo abre directo
# contra este origen porque una ruta BFF de Next no puede proxiar un upgrade
# de WebSocket. Por eso el puerto de la web (3002 en local) tiene que estar
# en esta lista, o el handshake del socket lo rechaza el propio navegador.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3002
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
BUSINESS_TIME_ZONE=America/La_Paz

# Gimnasio al que se adscriben las cuentas nuevas y las que aun no tienen uno.
# Vacio o ausente = instalacion de una sola marca (identidad de referencia).
DEFAULT_TENANT_ID=topfitness
ACCESS_POLICY_VERSION=2026-07-19
ACCESS_MOCK_ENABLED=true
# Número corporativo en formato internacional, solo dígitos (Bolivia: 591 + celular).
WHATSAPP_MEMBERSHIP_PHONE=59177377232
# Optional. When set (min. 32 chars), GET /health/metrics requires
# `Authorization: Bearer <token>`. Leave empty to keep the endpoint open and
# restrict it at network level instead.
METRICS_SCRAPE_TOKEN=

# Shared rate-limit counters. Without this, limits are per-process and the
# effective limit multiplies by the number of instances. Required for any
# horizontally scaled deployment.
REDIS_URL=
# Set true in multi-instance deployments to fail startup when REDIS_URL is absent
# instead of silently degrading to per-process rate limiting.
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_sheet
DB_USER=gym_sheet_writer
DB_PASSWORD=replace_with_runtime_secret
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000

JWT_ACCESS_SECRET=replace_with_at_least_64_random_characters_from_a_secret_manager
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_64_character_secret_from_a_secret_manager
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=gym-sheet-api
JWT_AUDIENCE=gym-sheet-web

PASSWORD_RESET_TOKEN_TTL=10m
PASSWORD_RESET_MAX_ATTEMPTS=5
# Dev-only: logs the raw reset PIN instead of emailing it. Refused when
# NODE_ENV=production. No email provider is wired into this backend yet.
PASSWORD_RESET_DEV_LOG_ENABLED=false

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# Tráfico anónimo del directorio público de gimnasios (sin sesión).
PUBLIC_RATE_LIMIT_MAX=60
GATEWAY_ENABLED=true

WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=5
WORKER_LOCK_TIMEOUT_MS=300000
WORKER_MAX_ATTEMPTS=5
# Retention for `yarn db:outbox:prune` (opt-in, dry-run unless run with --apply).
# Only COMPLETED outbox jobs older than this many days are eligible for deletion.
OUTBOX_RETENTION_DAYS=30
OUTBOX_PRUNE_BATCH_SIZE=1000
REMINDER_SCAN_INTERVAL_MS=3600000
# Expired-story purge worker (`yarn worker:stories-purge`). Deletes rows past
# `expires_at` and their files, keeping any file another row still references.
STORIES_PURGE_INTERVAL_MS=3600000
STORIES_PURGE_BATCH_SIZE=200
NOTIFICATION_DELIVERY_PROVIDER=IN_APP
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_SECRET=
NOTIFICATION_GATEWAY_ALLOWED_HOSTS=
NOTIFICATION_GATEWAY_TIMEOUT_MS=10000

EXERCISES_DATASET_ENABLED=false
EXERCISES_DATASET_JSON_URL=https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main/data/exercises.json
EXERCISES_DATASET_ALLOWED_HOSTS=raw.githubusercontent.com
EXERCISES_DATASET_TIMEOUT_MS=15000
EXERCISES_DATASET_MAX_RESPONSE_BYTES=25000000
EXERCISES_DATASET_BATCH_SIZE=100
EXERCISES_DATASET_MIN_RECORDS=1000
EXERCISES_DATASET_REFRESH_INTERVAL_MS=86400000
EXERCISES_DATASET_REFRESH_RETRY_MS=3600000
EXERCISES_DATASET_IMPORT_MEDIA=false
EXERCISES_DATASET_MEDIA_LICENSE_CONFIRMED=false
# Optional public-domain image enrichment. Only exact normalized names are linked.
EXERCISES_OPEN_MEDIA_ENABLED=true
EXERCISES_OPEN_MEDIA_JSON_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/dist/exercises.json
EXERCISES_OPEN_MEDIA_BASE_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/
# Canonical exercises source at startup (ADR-0006, option b). `seeders` applies a
# local snapshot if present; `github` defers population to the dataset worker and
# requires EXERCISES_DATASET_ENABLED=true (no silent fallback between sources).
CANONICAL_EXERCISES_SOURCE=seeders

# Base seed: both email and password are required by `yarn db:seed:base`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=GymSheet Administrator
# Development-only accounts created by `yarn db:seed:mock`.
SEED_MOCK_PASSWORD=

# --- Media storage (ports & adapters) ---
# Provider selection. `local` stores files on disk via the Multer adapter.
# `cloudinary`/`s3` require their adapter implemented (no silent fallback).
MEDIA_STORAGE_PROVIDER=local
# Local adapter: on-disk root and the public base URL it is served under.
MEDIA_STORAGE_LOCAL_ROOT=storage/media
MEDIA_STORAGE_PUBLIC_BASE_URL=http://localhost:3000/media
# Upload guards (bytes) and allowed MIME allowlist.
MEDIA_UPLOAD_MAX_BYTES=5242880
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif
# `yarn db:media:mirror --apply` copies external media.files images into the
# configured storage (forcing JPEG/PNG, fixing AVIF/WebP format breakage) and
# stops serving them straight from the external host. SSRF allowlist below.
MEDIA_MIRROR_ALLOWED_HOSTS=images.unsplash.com,raw.githubusercontent.com
MEDIA_MIRROR_TIMEOUT_MS=15000
# Optional credentials for a future CloudinaryAdapter. NEVER commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gymsheet
